# ---- required ----
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio"
REDIS_URL="redis://127.0.0.1:6379"
APP_URL="http://localhost:3000"

# Generate each of these separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In production these must be >= 32 chars and not the placeholder text below,
# or the app refuses to boot (src/lib/env.ts).
AUTH_SECRET="replace-with-a-long-random-string"
APP_ENCRYPTION_KEY="replace-with-a-long-random-string"
CRON_SECRET="replace-with-a-long-random-string"

# ---- GitHub (optional; a personal access token works without OAuth) ----
# https://github.com/settings/developers
# Homepage: $APP_URL   Callback: $APP_URL/api/integrations/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# ---- LinkedIn (optional; publishing only) ----
# https://www.linkedin.com/developers/apps
# Add BOTH products to the app, then wait for them to show as granted:
#   1. "Sign In with LinkedIn using OpenID Connect"  -> openid, profile, email
#   2. "Share on LinkedIn"                           -> w_member_social
# Authorized redirect URL: $APP_URL/api/integrations/linkedin/callback
#
# Reading your LinkedIn posts or profile history is NOT possible: that needs
# r_member_social, which LinkedIn restricts to approved partners. Import that
# evidence manually instead.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# LinkedIn versions its API by month (YYYYMM). Bump deliberately.
LINKEDIN_API_VERSION="202608"

# ---- curation (optional) ----
# Without this key, a transparent heuristic curator runs instead.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---- tuning (optional; defaults shown) ----
SYNC_CONCURRENCY="4"
QUEUE_ENQUEUE_TIMEOUT_MS="3000"
CRON_BATCH_SIZE="200"
AUTH_RATE_LIMIT="10"
AUTH_RATE_WINDOW_S="300"

# ---- LLM provider (optional) ----
# LLM_PROVIDER=openai|anthropic   (default: whichever key is set, OpenAI first)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
LLM_TIMEOUT_MS="30000"
LLM_MAX_RETRIES="2"
# Second-pass fact check on every curated item
CURATION_VERIFY="true"

# ---- public portfolio assistant (POST /api/agent/<slug>) ----
AGENT_ENABLED="true"
AGENT_RATE_LIMIT="12"
AGENT_RATE_WINDOW_S="300"
# Browser origins allowed to call it (comma-separated)
AGENT_ALLOWED_ORIGINS="https://ruturaj.is-a.dev,http://localhost:5173"
# Optional tracing: LANGSMITH_TRACING=true, LANGSMITH_API_KEY=...

# ---- one-click connections for every member (operator registers these ONCE) ----
# Members never create API keys; they click Connect. See README "Operator setup".
# GitLab: https://gitlab.com/-/user_settings/applications
#   Redirect URI: $APP_URL/api/integrations/gitlab/callback   Scope: read_api   Confidential: yes
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
# GitHub App (for writing to a member's site repo without a token):
# https://github.com/settings/apps/new
#   Setup URL: $APP_URL/api/integrations/github-app/callback
#   Tick "Request user authorization (OAuth) during installation" and "Redirect on update"
#   Repository permissions: Contents = Read and write, Pull requests = Read and write, Metadata = Read
#   Callback URL: same as Setup URL.  Webhook: untick Active.
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
# PEM text, "\n"-escaped PEM, or base64 of the PEM
GITHUB_APP_PRIVATE_KEY=""
